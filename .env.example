# ===================================================================
# GameDealPulse - Environment Configuration Template
# Copy this file to .env and configure your variables:
#   cp .env.example .env
# ===================================================================

# App Configuration
APP_NAME=GameDealPulse
APP_ENV=development
APP_PORT=8000
# Secret key used for JWT authentication and session security
SECRET_KEY=change_this_to_a_secure_random_key_for_jwt_session

# Database (SQLite by default, created automatically in ./data/app.db)
DATABASE_URL=sqlite:///./data/app.db

# CheapShark API (Public API, no registration or key required)
CHEAPSHARK_BASE_URL=https://www.cheapshark.com/api/1.0

# Resend Email Service (For price drop alert emails)
# - Sign up for free at https://resend.com to get your API key (starts with "re_")
# - If left empty or with placeholder, the app operates in MOCK MODE (alerts are logged to console)
RESEND_API_KEY=your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev
